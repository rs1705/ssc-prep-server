# Copy to .env and fill in. Never commit .env.

# Neon POOLED connection string (host contains "-pooler"). Used by the running app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Neon DIRECT connection string (no "-pooler"). Used only by `prisma migrate`.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Optional
PORT=8080

# Optional: comma-separated sites allowed to call the API. Unset = any site.
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Secret for admin routes (paper ingestion), sent as the x-admin-key header.
# Unset = admin routes are closed. Use a long random value.
# ADMIN_KEY=
