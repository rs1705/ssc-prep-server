// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// CORE DOMAIN

model User {
  id          String  @id @default(uuid())
  firebaseUid String  @unique
  email       String  @unique
  name        String?

  // Gamification & Tracking
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  xp            Int      @default(0)
  dailyGoal     Int      @default(30) // Drives the "Today's Target" UI
  lastLogin     DateTime @default(now())

  // Relationships
  sessions     Session[]
  interactions Interaction[]
  bookmarks    Bookmark[]
  fsrsData     FsrsData[]
  progress     UserProgress?
}

// Practice progress kept in sync across a user's devices: history, mistakes,
// daily plan, unfinished sessions and exam date, as one merged JSON document
// (see src/progress/merge.ts for how two copies are combined).
model UserProgress {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// TAXONOMY & GROUPING
// ----------------------------------------------------

// Represents a full PYQ shift (e.g. "SSC CGL 2024 Sept 9 Shift 1")
model ExamPaper {
  id       String    @id @default(uuid())
  title    String // e.g. "SSC CGL 2024 Tier 1 - 9th Sept Shift 1"
  examName String // "SSC CGL", "SSC CHSL", "SSC MTS"
  year     Int // 2024
  shift    String? // "Shift 1"
  date     DateTime?

  items    Item[]
  sessions Session[] // Users taking this full paper as a mock test
}

// ----------------------------------------------------
// THE UNIFIED ITEM (Question, Flashcard, Formula)
// ----------------------------------------------------

model Passage {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())

  items Item[]
}

model Item {
  id String @id @default(uuid())

  // Hierarchy
  subject   String // "English", "Maths", "Reasoning", "GK"
  topics    String[] // ["Geometry", "Vocabulary"]
  subtopics String[] // ["Triangles", "Idioms"]

  // Passage Relationship for Reading Comprehension
  passageId String?
  passage   Passage? @relation(fields: [passageId], references: [id])

  // Metadata
  type       String // "PYQ", "Flashcard", "Formula", "GameData"
  difficulty String? // "Easy", "Medium", "Hard"
  tags       String[] // ["high frequency", "tricky"]

  // Association to full papers (Many-to-Many)
  // Allows a single deduplicated question to appear in CGL 2023 Shift 1 AND CGL 2024 Shift 2
  examPapers ExamPaper[]

  // Deduplication hash (e.g. SHA-256 of the normalized question text)
  hash String? @unique

  // The Flexible Payload (JSONB)
  // For PYQ: { question: "...", options: ["A", "B", "C", "D"], answer: "A", imageUrl: "...", explanation: "..." }
  // For Vocab: { word: "Abate", hindi: "कम करना", synonyms: ["decrease"] }
  // For Formula: { title: "Area of Triangle", formula: "1/2 * b * h" }
  content Json

  // Relationships
  interactions Interaction[]
  bookmarks    Bookmark[]
  fsrsData     FsrsData[]
}

// ----------------------------------------------------
// USER PROGRESS & TRACKING
// ----------------------------------------------------

// Represents a user taking a Test, a Topic Quiz, or a Custom Mistake Quiz
model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Context of the session
  sessionType String // "FullPaper", "TopicQuiz", "CustomMistakeQuiz"
  title       String? // e.g., "Speed Math — Percentages" (For the UI)

  // If they are taking a full paper
  examPaperId String?
  examPaper   ExamPaper? @relation(fields: [examPaperId], references: [id])

  // Stats
  score      Int @default(0)
  totalItems Int @default(0)
  timeTaken  Int // total seconds spent on the quiz
  xpEarned   Int @default(0) // Drives the "+45 XP" UI on Recent Sessions

  isCompleted Boolean  @default(false) // Drives the Orange "Resume" Card UI
  createdAt   DateTime @default(now())

  interactions Interaction[]
}

// Atomic log of every single question/item attempted
// (Used to power the "Mistake Bank" and Weak Topic detection)
model Interaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Links this interaction to the specific quiz session they were taking
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Payload (Flexible for different items)
  isCorrect Boolean? // For PYQs and Quizzes
  rating    Int? // For Freestyle Flashcard swipes (1-4)
  timeTaken Int // seconds spent on this specific question
  createdAt DateTime @default(now())
}

// FSRS Spaced Repetition (For English Flashcards)
model FsrsData {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // FSRS fields
  dueDate       DateTime @default(now())
  stability     Float    @default(0)
  difficulty    Float    @default(0)
  elapsedDays   Int      @default(0)
  scheduledDays Int      @default(0)
  reps          Int      @default(0)
  lapses        Int      @default(0)
  state         Int      @default(0)
  lastReview    DateTime @default(now())

  @@unique([userId, itemId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}
